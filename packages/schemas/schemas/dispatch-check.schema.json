{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairclaim.dev/schemas/dispatch-check.json",
  "title": "DispatchCheck (normalized)",
  "type": "object",
  "additionalProperties": false,
  "required": ["seal_intact", "seal_code_read", "spill_or_damage_visible", "confidence"],
  "properties": {
    "seal_intact": { "type": "boolean" },
    "seal_code_read": { "$ref": "defs.json#/$defs/sealCodeRead" },
    "spill_or_damage_visible": { "type": "boolean" },
    "confidence": { "$ref": "defs.json#/$defs/confidence" }
  }
}
