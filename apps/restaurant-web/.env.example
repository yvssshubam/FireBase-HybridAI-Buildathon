# Copy to .env.local (git-ignored) for local dev; set the same names as Vercel env vars for production.
# Firebase web config values are public by design — API key restrictions + App Check protect them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise) site key. Required in production builds.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Grievance/contact address shown on /terms and /privacy. Required in production builds.
VITE_CONTACT_EMAIL=

# --- Development only (ignored by production builds) ---
# Optional fixed App Check debug token (register it in Firebase console → App Check → Apps → Manage debug tokens).
# Leave empty to let the SDK generate one and print it in the browser console.
# A production build FAILS if this is set.
VITE_APPCHECK_DEBUG_TOKEN=

# true = Auth/Firestore/Storage go to `npm run emulators` (project demo-fairclaim);
# AI Logic, App Check and Remote Config still use the real project above.
VITE_USE_EMULATORS=false

# true = fill the pages with sample claims generated in the browser (dev only; nothing is
# saved to Firebase, and production builds never include it). Real orders still appear.
VITE_DEMO_DATA=false

# Photo upload on the dispatch step, labelled "For the demo". On unless set to false.
# Turn it off for a real launch: an uploaded photo could be an old one.
VITE_ALLOW_PHOTO_UPLOAD=true
