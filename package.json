{
  "name": "fairclaim",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "packages/schemas",
    "engine",
    "rules-tests",
    "apps/restaurant-web"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:kotlin": "node scripts/gradle.mjs :engine:test :fft:test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-fairclaim \"npm -w @fairclaim/rules-tests run test:emulator\"",
    "gen": "npm -w @fairclaim/schemas run gen",
    "gen:check": "npm -w @fairclaim/schemas run gen:check",
    "seed:policy": "node scripts/seed-policy.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run gen:check && npm run lint && npm run typecheck && npm test",
    "build": "npm run build -w @fairclaim/restaurant-web",
    "dev:web": "npm run dev -w @fairclaim/restaurant-web",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-fairclaim",
    "dev:customer": "node --experimental-transform-types dev/customer-sim.ts",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-admin": "14.5.1",
    "firebase-tools": "15.37.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
